# Supabase Project URL (found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Key (found in Supabase Project Settings -> API)
# Safe for browser/client use; access is governed by Supabase Row Level Security (RLS) policies.
# NEVER place your Supabase service_role key here or in any frontend code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL (used to generate QR codes and redirect links)
# For local development: http://localhost:3000
# For production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
